rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Daftar pengguna untuk panel admin.
    // - Tiap pengguna hanya boleh menulis dokumen miliknya sendiri (field dibatasi).
    // - Hanya admin (email di bawah) yang boleh membaca semua dokumen.
    match /users/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'created', 'lastLogin']);
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.email == 'syahrurbaja@gmail.com');
      allow delete: if false;
    }
  }
}
