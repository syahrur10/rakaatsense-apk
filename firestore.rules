rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dokumen pengguna: users/{uid}  (name, email, created, lastLogin, stats, role)
    // - Pengguna hanya boleh menulis dokumennya sendiri, TANPA bisa mengubah field "role".
    // - Admin = email utama di bawah ATAU pengguna ber-role "admin". Admin boleh membaca semua & mengubah peran.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'syahrurbaja@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'));
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.keys().hasOnly(['name', 'email', 'created', 'lastLogin', 'stats']))
        || isAdmin());
      allow update: if request.auth != null && (
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'created', 'lastLogin', 'stats']))
        || isAdmin());
      allow delete: if isAdmin() && request.auth.uid != uid;
    }
    // Profil pengguna: profiles/{uid} (name, bio, birth, gender, city, photo, at) — hanya pemilik (dan admin untuk membaca).
    match /profiles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'bio', 'birth', 'gender', 'city', 'photo', 'at'])
        && request.resource.data.get('photo', '').size() < 180000
        && request.resource.data.get('bio', '').size() <= 400;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
