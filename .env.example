# Salin menjadi .env (lokal) atau isi di Vercel > Settings > Environment Variables.
# TANPA kunci Firebase, aplikasi jalan di MODE LOKAL (akun di perangkat) dan admin bawaan tetap bisa masuk.
# Ambil dari Firebase Console > Project settings > Your apps > Web app (config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# (opsional) Email admin, pisahkan dengan koma. Bawaan: syahrurbaja@gmail.com
VITE_ADMIN_EMAILS=syahrurbaja@gmail.com
